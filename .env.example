# 应用环境配置
# --------------------------------------------------------------
# 应用运行环境：development（开发）/production（生产）
FLASK_ENV=development
# 是否开启Flask调试模式
FLASK_DEBUG=True
# 是否开启调试模式
DEBUG=True
# --------------------------------------------------------------

# 数据库配置（请替换为您的安全数据库连接）
# --------------------------------------------------------------
# 主数据库
SQLALCHEMY_DATABASE_URI=""
# 测试环境数据库
SQLALCHEMY_DATABASE_URI_TEST=""
# 开发环境数据库
SQLALCHEMY_DATABASE_URI_DEV=""
# --------------------------------------------------------------

# 对象存储配置（请替换为您的OSS信息）
# --------------------------------------------------------------
OSS_ACCESS_KEY_ID="your_oss_access_key_id_here"
OSS_ACCESS_KEY_SECRET="your_oss_access_key_secret_here"

# 生产环境OSS配置
OSS_ENDPOINT="oss-your-region.aliyuncs.com"
OSS_BUCKET_NAME="your-bucket-name"
OSS_HOST="http://your-oss-host.com"

# 测试环境OSS配置
OSS_ENDPOINT_TEST="oss-your-test-region.aliyuncs.com"
OSS_BUCKET_NAME_TEST="your-test-bucket-name"
OSS_HOST_TEST="http://your-test-oss-host.com"

# 开发环境OSS配置
OSS_ENDPOINT_DEV="oss-your-dev-region.aliyuncs.com"
OSS_BUCKET_NAME_DEV="your-dev-bucket-name"
OSS_HOST_DEV="http://your-dev-oss-host.com"
# --------------------------------------------------------------

# Redis配置（请替换为您的Redis连接信息）
# --------------------------------------------------------------
REDIS_URL=""
REDIS_URL_TEST=""
REDIS_URL_DEV=""
# --------------------------------------------------------------

# 缓存配置
# --------------------------------------------------------------
# 缓存默认超时时间（秒）
CACHE_DEFAULT_TIMEOUT=300
# 缓存类型
CACHE_TYPE="redis"
# --------------------------------------------------------------

# JWT认证配置（请使用安全随机生成的密钥）
# --------------------------------------------------------------
JWT_SECRET_KEY="your_secure_random_jwt_secret_key_here"
# 访问令牌有效期（小时）
JWT_ACCESS_TOKEN_EXPIRES=24
# 刷新令牌有效期（小时）
JWT_REFRESH_TOKEN_EXPIRES=168
# --------------------------------------------------------------

# 日志配置
# --------------------------------------------------------------
# 日志目录
LOG_DIRECTORY="logs/large_requests"
# 最大日志文件大小（字节）
MAX_LOG_SIZE=1048576
# --------------------------------------------------------------

# 定时任务配置
# --------------------------------------------------------------
# Webhook 推送间隔（分钟），默认 1
WEBHOOK_PUSH_INTERVAL_MINUTES=1
# 库存快照执行时间（24小时制），默认凌晨 2:00
SNAPSHOT_HOUR=2
SNAPSHOT_MINUTE=0
# --------------------------------------------------------------

# 安全配置
# --------------------------------------------------------------
# 是否检查白名单
CHECK_WHITELIST=False
# 是否检查黑名单（需要 Redis；开关打开时启动会把数据库中的名单加载到 Redis）
CHECK_BLACKLIST=False
# 允许的跨域来源，生产环境必须填写管理端 / APP 的具体域名（逗号分隔），不要用 *
# Android APP 使用 WebViewAssetLoader，页面来源固定为 https://appassets.androidplatform.net，必须包含在内
CORS_ORIGINS=https://admin.example.com,https://appassets.androidplatform.net
# 前置反向代理层数（nginx 一层填 1）。为 0 时不信任 X-Forwarded-For，限流 / 审计日志会记录代理 IP
TRUSTED_PROXY_COUNT=1
# Webhook 回调 URL 严格校验：只允许 https 且拒绝内网地址。生产环境必须为 True
WEBHOOK_URL_STRICT=True
# 登录 / 找回密码等端点的限流开关
RATELIMIT_ENABLED=True
# 定时任务调度器开关：只在 WSGI 服务进程里为 True；执行 flask db upgrade / seed 等脚本时设为 False
SCHEDULER_ENABLED=True
# 加密 SMTP 密码等敏感设置的密钥（生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"）
# 设置或更换后需要在管理端重新录入 SMTP 密码
SETTINGS_ENCRYPTION_KEY=
# --------------------------------------------------------------

# 承运商对接：FedEx 自动建运单（可选；API Key / Secret Key / 账号缺任一项 = 功能关闭）
# --------------------------------------------------------------
# 测试环境 https://apis-sandbox.fedex.com（默认）；正式环境 https://apis.fedex.com（需先通过 FedEx 面单认证）
FEDEX_API_BASE=https://apis-sandbox.fedex.com
FEDEX_API_KEY=
FEDEX_SECRET_KEY=
FEDEX_ACCOUNT_NUMBER=
# 服务 / 揽收方式
FEDEX_SERVICE_TYPE=INTERNATIONAL_ECONOMY
FEDEX_PICKUP_TYPE=USE_SCHEDULED_PICKUP
# 面单：PDF 或 PNG（都存成 PDF）；纸张 PAPER_4X6 / PAPER_85X11_TOP_HALF_LABEL 等
FEDEX_LABEL_IMAGE_TYPE=PDF
FEDEX_LABEL_STOCK_TYPE=PAPER_4X6
# 电子贸易单证（ETD）：True 时建单前把商业发票上传给 FedEx
FEDEX_ETD_ENABLED=False
# 关税付款方：RECIPIENT / SENDER
FEDEX_DUTIES_PAYMENT_TYPE=RECIPIENT
# 超时（秒）
FEDEX_CONNECT_TIMEOUT_SECONDS=5
FEDEX_TIMEOUT_SECONDS=30
# --------------------------------------------------------------
